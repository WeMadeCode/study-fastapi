{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: mcp_server",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/l7_mcp_server.py",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Python Debugger: mcp_client",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/l7_mcp_client.py",
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "FastAPI: uvicorn (debug)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["study_fastapi.main:app", "--port", "8000"],
      "jinja": true,
      "justMyCode": true
    }
  ]
}
